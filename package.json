{
  "name": "pokelike-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Autoplayer for pokelike.xyz – Chrome extension (MV3) and userscript from one codebase",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs all",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:userscript": "node scripts/build.mjs userscript",
    "check:userscript": "node scripts/check-userscript.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:docs": "node scripts/check-docs.mjs",
    "runs:import": "node scripts/import-runs.mjs",
    "test": "vitest run",
    "e2e": "npm run build && playwright test --trace off",
    "e2e:live": "npm run build:chrome && LIVE=1 playwright test --trace off"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "espree": "10.4.0",
    "happy-dom": "^18.0.1",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^3.2.7"
  }
}
